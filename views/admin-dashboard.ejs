<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <title>لوحة الإدارة | OD Book</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        .dashboard-container { padding: 40px 8%; background: #f4f7f6; min-height: 100vh; }
        .stats-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-bottom: 40px; }
        .stat-card { background: #fff; padding: 25px; border-radius: 15px; text-align: center; box-shadow: 0 5px 15px rgba(0,0,0,0.05); }
        .stat-card i { font-size: 2rem; color: var(--main-orange); margin-bottom: 10px; }
        .stat-card h3 { font-size: 2rem; margin: 10px 0; }
        
        .admin-table { width: 100%; background: #fff; border-collapse: collapse; border-radius: 15px; overflow: hidden; box-shadow: 0 5px 15px rgba(0,0,0,0.05); }
        .admin-table th, .admin-table td { padding: 15px; text-align: right; border-bottom: 1px solid #eee; }
        .admin-table th { background: var(--main-orange); color: #fff; }
        .btn-add-new { background: #2ecc71; color: #fff; padding: 12px 25px; border-radius: 10px; text-decoration: none; display: inline-block; margin-bottom: 20px; font-weight: bold; }
        .btn-delete { background: #e74c3c; color: #fff; border: none; padding: 8px 15px; border-radius: 5px; cursor: pointer; }
    </style>
</head>
<body class="dashboard-container">

    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px;">
        <h1>لوحة تحكم المدير</h1>
        <a href="/" class="btn-login">معاينة الموقع ←</a>
    </div>

    <div class="stats-grid">
        <div class="stat-card">
            <i class="fas fa-book"></i>
            <p>إجمالي الكتب</p>
            <h3><%= books.length %></h3>
        </div>
        <div class="stat-card">
            <i class="fas fa-headphones"></i>
            <p>التصنيفات</p>
            <h3>4</h3>
        </div>
        <div class="stat-card">
            <i class="fas fa-users"></i>
            <p>المشاهدات</p>
            <h3>1.2k</h3>
        </div>
    </div>

    <a href="/admin/add" class="btn-add-new"><i class="fas fa-plus"></i> إضافة كتاب جديد</a>

    <table class="admin-table">
        <thead>
            <tr>
                <th>الغلاف</th>
                <th>عنوان الكتاب</th>
                <th>المؤلف</th>
                <th>التصنيف</th>
                <th>إجراءات</th>
            </tr>
        </thead>
        <tbody>
            <% books.forEach(book => { %>
                <tr>
                    <td><img src="/images/<%= book.img %>" width="50" style="border-radius: 5px;"></td>
                    <td><%= book.title %></td>
                    <td><%= book.author %></td>
                    <td><%= book.category || 'غير مصنف' %></td>
                    <td>
                        <form action="/admin/delete/<%= book.id %>" method="POST" style="display:inline;">
                            <button type="submit" class="btn-delete" onclick="return confirm('هل أنت متأكد من حذف هذا الكتاب؟')">
                                <i class="fas fa-trash"></i> حذف
                            </button>
                        </form>
                    </td>
                </tr>
            <% }) %>
        </tbody>
    </table>

</body>
</html>